{
    "prefix": "hcsoinn",
    "dataset": "cub",
    "memory_size": 0,
    "memory_per_class": 0,
    "fixed_memory": false,
    "shuffle": true,
    "init_cls": 10,
    "increment": 10,
    "model_name": "coda_prompt",
    "backbone_type": "vit_base_patch16_224_coda_prompt",
    "device": ["0"],
    "seed": [0],
    
    "tuned_epoch": 50,
    "init_lr": 0.001,
    "batch_size": 128,
    "weight_decay": 0,
    "min_lr": 1e-5,
    "optimizer": "adam",
    "scheduler": "cosine",
    "reinit_optimizer": true,

    "pretrained": true,
    "drop": 0.0,
    "drop_path": 0.0,

    "prompt_param": [100, 8.0, 0.0],

    "use_hc_soinn": true,
    "hcsoinn_max_proto_per_class": 60,
    "hcsoinn_alpha": 0.5,
    "hcsoinn_tau_merge": 0.2,
    "hcsoinn_tau_reject": 2.0,
    "hcsoinn_linkage": "average",
    "hcsoinn_distance": "cosine",
    "hcsoinn_use_soinn_refinement": true,
    "hcsoinn_soinn_ad": 20,
    "hcsoinn_soinn_lam": 20,
    "hcsoinn_soinn_threshold_scale": 0.8,
    "hcsoinn_soinn_max_iter": 1,

    "save_checkpoint": false,
    "checkpoint_dir": "checkpoints",
    "checkpoint_name": "coda_prompt_hc_soinn_cub",
    "load_all_checkpoints": false,

    "use_feature_alignment": true,
    "use_full_task_rehearsal": false,
    "test_only_first_task_classes": false
}
