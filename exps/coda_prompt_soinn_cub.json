{
    "prefix": " ",
    "dataset": "cub",
    "memory_size": 0,
    "memory_per_class": 0,
    "fixed_memory": false,
    "shuffle": true,
    "init_cls": 10,
    "increment": 10,
    "model_name": "coda_prompt",
    "backbone_type": "vit_base_patch16_224_coda_prompt",
    "device": ["0"],
    "seed": [0],
    
    "tuned_epoch": 50,
    "init_lr": 0.001,
    "batch_size": 128,
    "weight_decay": 0,
    "min_lr": 1e-5,
    "optimizer": "adam",
    "scheduler": "cosine",
    "reinit_optimizer": true,

    "pretrained": true,
    "drop": 0.0,
    "drop_path": 0.0,

    "prompt_param": [100, 8.0, 0.0],

    "use_soinn": true,
    "soinn_ad": 50,
    "soinn_lam": 50,
    "soinn_max_nodes_per_class": null,
    "soinn_threshold_scale": 0.75,
    "soinn_k_neighbors": 3,

    "save_checkpoint": false,
    "checkpoint_dir": "checkpoints",
    "checkpoint_name": "coda_prompt_soinn_cub",
    "load_all_checkpoints": false
}

