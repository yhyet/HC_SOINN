{
    "prefix": "speed_profile_kac",
    "dataset": "cifar224",
    "memory_size": 0,
    "memory_per_class": 0,
    "fixed_memory": false,
    "shuffle": false,
    "init_cls": 10,
    "increment": 10,
    "model_name": "coda_prompt",
    "backbone_type": "vit_base_patch16_224_coda_prompt",
    "device": ["0"],
    "seed": [0],

    "tuned_epoch": 1,
    "init_lr": 0.001,
    "batch_size": 128,
    "weight_decay": 0,
    "min_lr": 1e-5,
    "optimizer": "adam",
    "scheduler": "cosine",
    "reinit_optimizer": true,

    "pretrained": true,
    "drop": 0.0,
    "drop_path": 0.0,

    "prompt_param": [100, 8.0, 0.0],

    "use_kac": true,
    "kac_config": {
        "grid_min": -2.0,
        "grid_max": 2.0,
        "num_grids": 16,
        "spline_weight_init_scale": 0.1
    },

    "save_checkpoint": false,
    "checkpoint_dir": "checkpoints",
    "checkpoint_name": "speed_profile_coda_prompt_cifar_kac",
    "load_all_checkpoints": false,

    "use_feature_alignment": false,
    "use_full_task_rehearsal": false,
    "use_ncm": false,
    "eval_fc": false,
    "test_only_first_task_classes": false,
    "analyze_cluster_structure_drift": false,

    "speed_profile_last_task": true,
    "speed_profile_classifiers": ["kac"],
    "speed_profile_repeats": 3,
    "speed_profile_sync_cuda": true,
    "speed_profile_output_prefix": "resources/coda_prompt_cifar10task_speed_profile"
}
