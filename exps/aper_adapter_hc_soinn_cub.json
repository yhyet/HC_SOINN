{
    "prefix": "try3",
    "dataset": "cub",
    "memory_size": 0,
    "memory_per_class": 0,
    "fixed_memory": false,
    "shuffle": true,
    "init_cls": 10,
    "increment": 10,
    "model_name": "aper_adapter",
    "backbone_type": "pretrained_vit_b16_224_adapter",
    "device": ["0"],
    "seed": [1993],
    
    "tuned_epoch": 20,
    "init_lr": 0.01,
    "batch_size": 48,
    "weight_decay": 0.0005,
    "min_lr": 0,
