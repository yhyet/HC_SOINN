    "hcsoinn_use_soinn_refinement": true,
    "hcsoinn_soinn_ad": 20,
    "hcsoinn_soinn_lam": 20,
    "hcsoinn_soinn_threshold_scale": 0.5,
    "hcsoinn_soinn_max_iter": 1,
    "hcsoinn_soinn_max_degree_for_removal": 0,

    "test_only_first_task_classes": false,

    "analyze_cluster_structure_drift": false
