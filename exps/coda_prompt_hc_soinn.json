{
    "prefix": " hcsoinn_star",
    "dataset": "cifar224",
    "memory_size": 0,
    "memory_per_class": 0,
    "fixed_memory": false,
    "shuffle": false,
    "init_cls": 10,
    "increment": 10,
    "model_name": "coda_prompt",
    "backbone_type": "vit_base_patch16_224_coda_prompt",
    "device": ["0"],
    "seed": [0],
    
    "tuned_epoch": 20,
    "init_lr": 0.001,
    "batch_size": 128,
    "weight_decay": 0,
    "min_lr": 1e-5,
    "optimizer": "adam",
    "scheduler": "cosine",
    "reinit_optimizer": true,

    "pretrained": true,
    "drop": 0.0,
    "drop_path": 0.0,

    "prompt_param": [100, 8.0, 0.0],

    "use_hc_soinn": true,
    "hcsoinn_max_proto_per_class": 20,
    "hcsoinn_alpha": 0.5,
    "hcsoinn_tau_merge": 0.2,
    "hcsoinn_tau_reject": 2.0,
    "hcsoinn_linkage": "average",
    "hcsoinn_distance": "cosine",

    "save_checkpoint": true,
    "checkpoint_dir": "checkpoints",
    "checkpoint_name": "coda_prompt_hc_soinn_cifar",
    "load_all_checkpoints": false,


    "use_feature_alignment": true,
    "alignment_k": 15
}

